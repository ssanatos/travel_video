{
  "name": "포토 월드맵",
  "short_name": "포토 월드맵",
  "description": "사진 위치로 지도를 채우고 자막·TTS 영상으로 만들기",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0b0d12",
  "theme_color": "#0b0d12",
  "lang": "ko",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "photos", "accept": ["image/*", ".jpg", ".jpeg", ".png", ".heic", ".heif", ".webp"] }
      ]
    }
  }
}
